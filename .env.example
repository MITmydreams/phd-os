# Copy to .env.local for local cloud sync (never commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Optional — sharp campus maps on /map (free key from https://cloud.maptiler.com/account/keys/)
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key
